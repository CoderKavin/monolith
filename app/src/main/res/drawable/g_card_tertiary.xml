<?xml version="1.0" encoding="utf-8"?>
<!-- Glass: translucent fill fading from top-left, with a thin bright edge. Widgets can't blur, so no backdrop blur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/card_radius" />
    <gradient android:angle="315" android:startColor="@color/glass_ter_top" android:endColor="@color/glass_ter_bottom" android:type="linear" />
    <stroke android:width="1dp" android:color="@color/glass_edge" />
</shape>
