<?xml version="1.0" encoding="utf-8"?>
<!-- Clock · Display centred (4×2, no background). The time is sized in code to the largest
     size that fits, and centred on its ink so the space above and below is equal. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">
        <ImageView android:id="@+id/t_sh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tint="@color/g_wall_shadow" />
        <ImageView android:id="@+id/t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tint="@color/g_on_wall" />
    </FrameLayout>
</FrameLayout>
