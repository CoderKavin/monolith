<?xml version="1.0" encoding="utf-8"?>
<!-- Clock · Display centred (4×2, no background). The time is sized in code to the largest
     size that fits, and centred on its ink so the space above and below is equal. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fills the widget and scales the time to fit, so it uses the real width even if the
         launcher reports a smaller size. -->
    <ImageView android:id="@+id/t" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:tint="@color/g_wall_tint" />
</FrameLayout>
