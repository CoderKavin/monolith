<?xml version="1.0" encoding="utf-8"?>
<!-- Battery · power saving on (2×2). Card fills with the tertiary container colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/g_card_tertiary"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/b_icon" android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_leaf" android:tint="@color/g_on_tertiary_c" />
        <TextView android:id="@+id/b_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="@font/gsf_t540" android:maxLines="1" android:text="Power saving" android:textColor="@color/g_on_tertiary_c" android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1">
        <ImageView android:id="@+id/b_track" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/g_track_on_ter" />
        <ImageView android:id="@+id/b_act" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/g_on_tertiary_c" />
        <TextView android:id="@+id/b_level" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="@font/gsf_r620" android:gravity="center" android:includeFontPadding="false" android:letterSpacing="-0.02" android:maxLines="1" android:text="45%" android:textColor="@color/g_on_tertiary_c" android:textSize="40sp" />
    </FrameLayout>
</LinearLayout>
