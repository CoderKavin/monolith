<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by both Screen time widgets until Usage access is allowed. Tap opens the setting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/g_card"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_hourglass" android:tint="@color/g_on_surface_var" />
        <ImageView android:id="@+id/p_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:tint="@color/g_on_surface_var" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <ImageView android:id="@+id/p_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tint="@color/g_on_surface" />
    <ImageView android:id="@+id/p_body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:tint="@color/g_on_surface_var" />
</LinearLayout>
