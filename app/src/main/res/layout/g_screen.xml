<?xml version="1.0" encoding="utf-8"?>
<!-- Screen time (4×2) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/g_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_hourglass"
            android:tint="@color/g_on_surface_var" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/gsf_t540"
            android:text="Screen time"
            android:textColor="@color/g_on_surface_var"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/st_chip"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/g_chip_secondary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/st_arrow"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_arrow_down"
                android:tint="@color/g_on_secondary_c" />

            <TextView
                android:id="@+id/st_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/gsf_t540"
                android:maxLines="1"
                android:text="18m vs yesterday"
                android:textColor="@color/g_on_secondary_c"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/st_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/gsf_r620"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:text="1h 38m"
        android:textColor="@color/g_on_surface"
        android:textSize="54sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="12dp">

        <ImageView android:id="@+id/seg0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:tint="@color/g_primary" />
        <ImageView android:id="@+id/seg1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:tint="@color/g_tertiary" />
        <ImageView android:id="@+id/seg2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:tint="@color/g_secondary" />
        <ImageView android:id="@+id/seg3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:tint="@color/g_track" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/lg0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot" android:tint="@color/g_primary" />
            <TextView android:id="@+id/lg_n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:fontFamily="@font/gsf_t620" android:maxLines="1" android:maxWidth="72dp" android:text="Chat" android:textColor="@color/g_on_surface" android:textSize="12sp" />
            <TextView android:id="@+id/lg_t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/gsf_t540" android:maxLines="1" android:text="41m" android:textColor="@color/g_on_surface_var" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/lg1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot" android:tint="@color/g_tertiary" />
            <TextView android:id="@+id/lg_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:fontFamily="@font/gsf_t620" android:maxLines="1" android:maxWidth="72dp" android:text="Video" android:textColor="@color/g_on_surface" android:textSize="12sp" />
            <TextView android:id="@+id/lg_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/gsf_t540" android:maxLines="1" android:text="29m" android:textColor="@color/g_on_surface_var" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/lg2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot" android:tint="@color/g_secondary" />
            <TextView android:id="@+id/lg_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:fontFamily="@font/gsf_t620" android:maxLines="1" android:maxWidth="72dp" android:text="Browser" android:textColor="@color/g_on_surface" android:textSize="12sp" />
            <TextView android:id="@+id/lg_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/gsf_t540" android:maxLines="1" android:text="16m" android:textColor="@color/g_on_surface_var" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
