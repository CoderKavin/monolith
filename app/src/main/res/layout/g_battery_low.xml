<?xml version="1.0" encoding="utf-8"?>
<!-- Battery · low, 20% or less (2×2). No header: the state shows as a small icon under the percentage and in the card colour. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/g_card"
    android:padding="14dp">

    <ImageView android:id="@+id/b_track" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/g_track" />
    <ImageView android:id="@+id/b_act" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:tint="@color/g_error" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <ImageView android:id="@+id/b_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tint="@color/g_on_surface" />
            <ImageView android:id="@+id/b_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tint="@color/g_on_surface_var" />
        </FrameLayout>
        <ImageView android:id="@+id/b_icon" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginTop="4dp" android:src="@drawable/ic_alert" android:tint="@color/g_error" />
    </LinearLayout>
</FrameLayout>
