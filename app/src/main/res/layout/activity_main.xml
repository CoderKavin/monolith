<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gsf_t540"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="40sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/gsf_t540"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/tagline"
            android:textColor="@color/ink_2"
            android:textSize="15sp" />

        <!-- Updates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gsf_t620"
                    android:text="@string/update_title"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/update_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/gsf_t540"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/update_checking"
                    android:textColor="@color/ink_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/update_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/pill"
                android:fontFamily="@font/gsf_t620"
                android:paddingStart="18dp"
                android:paddingTop="9dp"
                android:paddingEnd="18dp"
                android:paddingBottom="9dp"
                android:text="@string/update_check"
                android:textColor="@color/app_bg"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Dock bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gsf_t620"
                    android:text="Dock bar"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/gsf_t540"
                    android:lineSpacingMultiplier="1.15"
                    android:text="A glass or solid bar behind the apps in your dock, built into your wallpaper."
                    android:textColor="@color/ink_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dock_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/pill"
                android:fontFamily="@font/gsf_t620"
                android:paddingStart="18dp"
                android:paddingTop="9dp"
                android:paddingEnd="18dp"
                android:paddingBottom="9dp"
                android:text="Open"
                android:textColor="@color/app_bg"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Usage access -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gsf_t620"
                    android:text="@string/usage_title"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/usage_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/gsf_t540"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/usage_off"
                    android:textColor="@color/ink_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/usage_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/pill"
                android:fontFamily="@font/gsf_t620"
                android:paddingStart="18dp"
                android:paddingTop="9dp"
                android:paddingEnd="18dp"
                android:paddingBottom="9dp"
                android:text="@string/usage_button"
                android:textColor="@color/app_bg"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Power saving -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gsf_t620"
                android:text="@string/saver_title"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/saver_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/gsf_t540"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/saver_off"
                android:textColor="@color/ink_2"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/gsf_t540"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/tip"
            android:textColor="@color/ink_3"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
