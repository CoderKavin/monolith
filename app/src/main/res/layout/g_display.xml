<?xml version="1.0" encoding="utf-8"?>
<!-- Clock · Display (4×2, no background). Text is drawn in code; each image carries a 12dp
     margin for its shadow, which the negative margins cancel out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:layout_marginTop="-12dp">
        <ImageView android:id="@+id/t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tint="@color/g_on_wall" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="-12dp">
        <ImageView android:id="@+id/d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tint="@color/g_wall_accent" />
    </FrameLayout>
</LinearLayout>
