<?xml version="1.0" encoding="utf-8"?>
<!-- Clock · Display (4×2, no background) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <TextClock
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="136sp"
        android:autoSizeMinTextSize="40sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/gsf_r580"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:gravity="start|bottom"
        android:includeFontPadding="false"
        android:letterSpacing="-0.04"
        android:maxLines="1"
        android:shadowColor="@color/g_wall_shadow"
        android:shadowDy="2"
        android:shadowRadius="18"
        android:textColor="@color/g_on_wall" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/gsf_t540"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:maxLines="1"
        android:shadowColor="@color/g_wall_shadow"
        android:shadowDy="2"
        android:shadowRadius="18"
        android:textColor="@color/g_wall_accent"
        android:textSize="18sp" />
</LinearLayout>
