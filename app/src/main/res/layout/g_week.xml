<?xml version="1.0" encoding="utf-8"?>
<!-- Week (4×2). All text is drawn in code; pill colours are set per day. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/g_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingEnd="2dp">
        <ImageView android:id="@+id/wk_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tint="@color/g_on_surface" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:id="@+id/wk_no" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="1dp" android:tint="@color/g_on_surface_var" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/p0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/g_pill" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="12dp">
            <ImageView android:id="@+id/l0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.8" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <ImageView android:id="@+id/n0" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/p1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/g_pill" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="12dp">
            <ImageView android:id="@+id/l1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.8" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <ImageView android:id="@+id/n1" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/p2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/g_pill" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="12dp">
            <ImageView android:id="@+id/l2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.8" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <ImageView android:id="@+id/n2" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/p3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/g_pill" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="12dp">
            <ImageView android:id="@+id/l3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.8" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <ImageView android:id="@+id/n3" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/p4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/g_pill" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="12dp">
            <ImageView android:id="@+id/l4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.8" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <ImageView android:id="@+id/n4" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/p5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/g_pill" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="12dp">
            <ImageView android:id="@+id/l5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.8" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <ImageView android:id="@+id/n5" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/p6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/g_pill" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="12dp">
            <ImageView android:id="@+id/l6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.8" />
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <ImageView android:id="@+id/n6" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
